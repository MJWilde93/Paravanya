    pygame.draw.rect(surf, (60, 30, 30),  (bx, by, bar_w, 8))
    pygame.draw.rect(surf, CRIMSON,       (bx, by, int(bar_w * prog), 8))
    pygame.draw.rect(surf, GOLD,          (bx, by, bar_w, 8), 1)
