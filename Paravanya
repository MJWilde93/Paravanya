    surf.blit(kills_lbl, (DISPLAY_W - 120, 44))


# ── Health drops ─────────────────────────────────────────────────────────────
class HealthDrop:
    DROP_CHANCE  = 0.35   # 35 % chance on kill
    LIFETIME     = 360    # frames before it disappears (6 s)
    BOB_AMP      = 4      # pixels of vertical bobbing
    BOB_SPEED    = 0.08

    def __init__(self, world_x):
        self.world_x  = float(world_x)
        self.y        = float(GROUND_Y - 20)
        self.timer    = 0
        self.collected = False

    def update(self, player_x, world_offset):
        if self.collected:
            return False
        self.timer += 1
        screen_x = self.world_x - world_offset
        # Simple pick-up collision — generous radius
        if abs(screen_x - player_x) < 30 and abs(self.y - GROUND_Y + 20) < 40:
            self.collected = True
            return True   # signal: heal player
        return False

    @property
    def expired(self):
        return self.timer >= self.LIFETIME or self.collected

    def draw(self, surf, world_offset):
        if self.collected:
            return
        sx = int(self.world_x - world_offset)
        bob = math.sin(self.timer * self.BOB_SPEED) * self.BOB_AMP
        cy = int(self.y + bob)

        # Fade out in last 90 frames
        alpha = 255
        if self.timer > self.LIFETIME - 90:
            alpha = int(255 * (self.LIFETIME - self.timer) / 90)

        # Draw a glowing heart
        size = 10
        heart = pygame.Surface((size*2+4, size*2+4), pygame.SRCALPHA)
        # Two circles + a triangle = heart shape
        col = (220, 60, 60, alpha)
        pygame.draw.circle(heart, col, (5, 6),  6)
        pygame.draw.circle(heart, col, (17, 6), 6)
        pts = [(1, 9), (23, 9), (12, 22)]
        pygame.draw.polygon(heart, col, pts)
        # Bright highlight
        pygame.draw.circle(heart, (255, 160, 160, min(alpha, 200)), (7, 5), 3)
        surf.blit(heart, (sx - size - 2, cy - size - 2))

        # Subtle glow ring
        if alpha > 60:
            glow = pygame.Surface((36, 36), pygame.SRCALPHA)
            pygame.draw.circle(glow, (220, 60, 60, alpha // 5), (18, 18), 16)
            surf.blit(glow, (sx - 18, cy - 18))


# ── Enemy spawner ──────────────────────────────────────────────────────────────
def maybe_spawn(enemies, world_offset, frame_count, lvl_mgr):
    interval = lvl_mgr.spawn_interval()
    max_e    = lvl_mgr.max_enemies()
    if len(enemies) < max_e and frame_count % interval == 0:
        spawn_x = world_offset + DISPLAY_W + random.randint(50, 200)
        sk = Skeleton(spawn_x, lvl_mgr)
        enemies.append(sk)


# ── Main game loop ─────────────────────────────────────────────────────────────
def run_game():
    # Load layers
    bg          = BGSky(asset("parallax-mountain-bg.png"))
    far_mtn     = ParallaxLayer(asset("parallax-mountain-montain-far.png"), 0.05)
    mountains   = ParallaxLayer(asset("parallax-mountain-mountains.png"),   0.15)
    trees       = ParallaxLayer(asset("parallax-mountain-trees.png"),       0.30)
    fg_trees    = ParallaxLayer(asset("parallax-mountain-foreground-trees.png"), 0.55)
    ground      = GroundLayer(asset("wall128x128.png"))

    player   = Player()
    lvl_mgr  = LevelManager()
    world_offset = 0.0   # cumulative world scroll

    # Initial enemies
    enemies = [Skeleton(DISPLAY_W * 0.8 + i * 260, lvl_mgr) for i in range(3)]
    drops   = []

    # Music
    try:
        pygame.mixer.music.load(asset("parallax-mountain-music.flac"))
        pygame.mixer.music.set_volume(0.5)
        pygame.mixer.music.play(-1)
    except:
        pass

    frame_count  = 0
    game_over    = False
    title_screen = True

    while True:
        events = pygame.event.get()
        for ev in events:
            if ev.type == pygame.QUIT:
                return False
            if ev.type == pygame.KEYDOWN:
                if ev.key in (pygame.K_ESCAPE, pygame.K_q):
                    return False
                if title_screen:
                    title_screen = False
                if game_over and ev.key == pygame.K_r:
                    return True   # signal: restart

        if not title_screen and not game_over:
            frame_count += 1

            # ── Player input & update ─────────────────────────────────────────
            player.handle_input(events)
            player.update()
            dx = player.world_scroll_dx()
            world_offset += dx

            # ── Scroll layers ─────────────────────────────────────────────────
            far_mtn.scroll(dx)
            mountains.scroll(dx)
            trees.scroll(dx)
            fg_trees.scroll(dx)
            ground.scroll(dx)

            # ── Enemy logic ───────────────────────────────────────────────────
            maybe_spawn(enemies, world_offset, frame_count, lvl_mgr)
            lvl_mgr.update()
            attack_rect = player.attack_rect()
            for e in enemies:
                hit_player = e.update(player.x, world_offset, attack_rect)
                if hit_player and not player.dead:
                    player.take_hit(1)
                if not e.alive and e.death_timer == 1:
                    player.score += int(100 * e.size_scale * lvl_mgr.level)
                    lvl_mgr.register_kill()
                    if random.random() < HealthDrop.DROP_CHANCE:
                        drops.append(HealthDrop(e.x - world_offset + world_offset))
            # Mark attack as having landed once collision found
            if attack_rect:
                for e in enemies:
                    if e.alive and e.invuln > 0:
                        player.attack_hit = True
                        break
            enemies = [e for e in enemies if not e.screen_dead_and_done]

            # ── Health drops ──────────────────────────────────────────────────
            for d in drops:
                healed = d.update(player.x, world_offset)
                if healed and player.hp < player.MAX_HP:
                    player.hp += 1
                    spawn_hit_particles(int(player.x), int(player.y) - 40, HPGREEN, 12)
            drops = [d for d in drops if not d.expired]

            if player.dead:
                game_over = True

        # ── Draw ─────────────────────────────────────────────────────────────
        bg.draw(screen)
        far_mtn.draw(screen)
        mountains.draw(screen)
        trees.draw(screen)
        fg_trees.draw(screen)
        ground.draw(screen)

        # Player (drawn first so enemies appear on top when attacking)
        player.draw(screen)

        # Enemies
        for e in enemies:
            e.draw(screen, world_offset)

        # Health drops
        for d in drops:
            d.draw(screen, world_offset)

        # Particles
        update_draw_particles(screen)

        # (attack arc visual removed)

        # HUD
        if not title_screen:
            draw_hud(screen, player)
            draw_level_hud(screen, lvl_mgr)
            if lvl_mgr.showing_banner:
                draw_level_banner(screen, lvl_mgr)

        if title_screen:
            draw_title(screen)
        elif game_over:
            draw_game_over(screen, player.score)

        pygame.display.flip()
        clock.tick(FPS)

def main():
    while True:
        restart = run_game()
        if not restart:
            break
    pygame.quit()
    sys.exit()

if __name__ == "__main__":
    main()
