# ── Level system ──────────────────────────────────────────────────────────────
class LevelManager:
    """Tracks the current level and scales enemy difficulty."""

    def __init__(self):
        self.level          = 1
        self.kills_needed   = self._kills_for(1)
        self.kills_this_lvl = 0
        self.level_up_timer = 0        # >0 = showing level-up banner
        self.BANNER_FRAMES  = 180      # 3 seconds at 60 fps

    def _kills_for(self, lvl):
        return 3 + (lvl - 1) * 2      # 3, 5, 7, 9 …

    @property
    def showing_banner(self):
        return self.level_up_timer > 0

    def register_kill(self):
        self.kills_this_lvl += 1
        if self.kills_this_lvl >= self.kills_needed:
            self.kills_this_lvl = 0
            self.level += 1
            self.kills_needed   = self._kills_for(self.level)
            self.level_up_timer = self.BANNER_FRAMES
            return True   # levelled up
        return False

    def update(self):
        if self.level_up_timer > 0:
            self.level_up_timer -= 1

    # Difficulty knobs ---------------------------------------------------------
    def enemy_scale_range(self):
        """MIN/MAX size_scale grows slightly each level."""
        lo = min(0.8 + (self.level - 1) * 0.05, 1.1)
        hi = min(1.6 + (self.level - 1) * 0.08, 2.4)
        return lo, hi

    def spawn_interval(self):
        """Frames between spawns — shrinks each level, floor 150."""
        return max(150, 420 - (self.level - 1) * 30)

    def max_enemies(self):
        """More enemies on screen at higher levels."""
        return min(3 + self.level, 10)


def draw_level_banner(surf, lvl_mgr):
    """Animated level-up banner shown for BANNER_FRAMES frames."""
    t = lvl_mgr.level_up_timer
    total = lvl_mgr.BANNER_FRAMES
    # Fade in for first 20 frames, fade out for last 40
    if t > total - 20:
        alpha = int(255 * (total - t) / 20)
    elif t < 40:
        alpha = int(255 * t / 40)
    else:
        alpha = 255

    panel = pygame.Surface((420, 80), pygame.SRCALPHA)
    panel.fill((0, 0, 0, min(alpha, 160)))
    px = DISPLAY_W // 2 - 210
    py = DISPLAY_H // 2 - 60
    surf.blit(panel, (px, py))

    def ra(color):
        return (*color[:3], alpha)

    t1 = font_big.render(f"LEVEL  {lvl_mgr.level}", True, GOLD)
    t2 = font_small.render(f"Defeat {lvl_mgr.kills_needed} skeletons to advance", True, WHITE)
    t1.set_alpha(alpha); t2.set_alpha(alpha)
    surf.blit(t1, (DISPLAY_W // 2 - t1.get_width() // 2, py + 4))
    surf.blit(t2, (DISPLAY_W // 2 - t2.get_width() // 2, py + 54))


def draw_level_hud(surf, lvl_mgr):
    """Small level + progress bar in top-right corner."""
    lbl = font_small.render(f"LVL {lvl_mgr.level}", True, GOLD)
    surf.blit(lbl, (DISPLAY_W - 120, 14))
    # Kill progress bar
    bar_w = 100
    bx = DISPLAY_W - 120
    by = 34
